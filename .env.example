# ==============================================================================
# ADK Sonar Voice Orchestrator — Local & Cloud Run Configuration (.env.example)
# Run `make onboard` to auto-populate GCP & GitHub settings from your local CLI.
# ==============================================================================

# 1. Gemini Live & Google Cloud / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Optional: Gemini API Key (Google AI Studio) for Live Voice session
# GEMINI_API_KEY=your-gemini-api-key

# 2. Shared Vertex Agent Engine Sandbox & Coding Harnesses (horizon | antigravity | claude)
CODING_HARNESS=horizon
WORKER_BACKEND=sandbox
# SANDBOX_GCP_PROJECT=your-gcp-project-id
SANDBOX_GCP_LOCATION=us-central1
CLAUDE_CODE_USE_VERTEX=1
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id

# 3. Connected Apps (Ordered: Workspace -> Search -> Maps -> GitHub -> Spotify -> Slack)

# 3a. Google Workspace (Calendar, Gmail, Drive)
# Auto-populated locally via `gcloud auth print-access-token` during `make onboard`,
# or via Google OAuth 2.0 Client ID & Secret for deployed Cloud Run services:
# GOOGLE_WORKSPACE_ACCESS_TOKEN=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_WORKSPACE_REFRESH_TOKEN=

# 3b. GitHub MCP (Pull requests, issues & CI checks)
# Auto-populated locally via `gh auth token` during `make onboard`:
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# 3c. Spotify MCP (Playback, focus playlists & queue control)
# Create an app at https://developer.spotify.com/dashboard
# Add Redirect URI: http://127.0.0.1:8000/api/v1/auth/spotify/callback
# (or https://<your-cloud-run-url>/api/v1/auth/spotify/callback when deployed)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
# SPOTIFY_ACCESS_TOKEN=

# 3d. Slack MCP (Channel threads & status updates)
# Create a Bot Token (xoxb-...) at https://api.slack.com/apps
# (`SLACK_TEAM_ID` is auto-discovered via slack.com/api/auth.test)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_TEAM_ID=
